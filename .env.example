# Salin jadi .env.local lalu isi dari Supabase Dashboard > Project Settings > API

# URL project Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# anon key (dipakai browser untuk Realtime subscribe — hanya boleh baca, dijaga RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# service role key (HANYA server — bypass RLS, dipakai /api/mcp & /api/rooms)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
